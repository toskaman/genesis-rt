{
  "schema_version": 2,
  "machine": {
    "id": "amr-demo-01",
    "kind": "differential_drive_robot",
    "profile": "amr-showcase",
    "execution_target": "qnx8_x86_64_qemu",
    "arch": "x86_64",
    "simulation_only": true
  },
  "actuators": [
    {"id": "left-motor", "type": "velocity_command", "unit": "mps",
     "bounds": {"min": -1.2, "max": 1.2}, "rate_limit": 3.0, "fault_response": "safe_stop"},
    {"id": "right-motor", "type": "velocity_command", "unit": "mps",
     "bounds": {"min": -1.2, "max": 1.2}, "rate_limit": 3.0, "fault_response": "safe_stop"}
  ],
  "sensors": [
    {"id": "proximity", "type": "distance_m", "unit": "m",
     "freshness_limit_ms": 100, "range": {"min": 0.0, "max": 10.0}},
    {"id": "odometry", "type": "odometry", "unit": "m_rad", "freshness_limit_ms": 100}
  ],
  "control": {
    "period_ms": 10,
    "deadline_ms": 10,
    "max_linear_speed_mps": 1.2,
    "max_angular_speed_radps": 1.0,
    "scheduling": {"policy": "periodic", "priority": 10},
    "guarded_state_transitions": true
  },
  "states": [
    {"id": "init", "safe": false, "initial": true},
    {"id": "running", "safe": false, "initial": false},
    {"id": "safe_stop", "safe": true, "initial": false}
  ],
  "transitions": [
    {"from": "init", "to": "running", "event": "start"},
    {"from": "running", "to": "safe_stop", "event": "fault_detected"},
    {"from": "running", "to": "safe_stop", "event": "estop"},
    {"from": "safe_stop", "to": "init", "event": "reset"}
  ],
  "commands": [
    {"id": "left-motor-cmd", "actuator": "left-motor", "deadline_ms": 10,
     "fields": [{"name": "velocity", "unit": "mps", "min": -1.2, "max": 1.2}]},
    {"id": "right-motor-cmd", "actuator": "right-motor", "deadline_ms": 10,
     "fields": [{"name": "velocity", "unit": "mps", "min": -1.2, "max": 1.2}]}
  ],
  "telemetry": [
    {"id": "proximity-tm", "source": "proximity", "rate_hz": 10},
    {"id": "odometry-tm", "source": "odometry", "rate_hz": 100}
  ],
  "safety_contracts": [
    {"name": "stale-proximity-stop", "if": "proximity_is_stale", "then": "command_virtual_stop"},
    {"name": "speed-limit", "if": "speed_exceeds_limit", "then": "reject_command"},
    {"name": "simulator-watchdog", "if": "simulator_disconnected", "then": "command_virtual_stop"}
  ],
  "fault_responses": [
    {"fault": "stale_sensor", "enter_state": "safe_stop", "action": "command_virtual_stop"},
    {"fault": "command_rejected", "enter_state": "safe_stop", "action": "reject_command"},
    {"fault": "simulator_disconnect", "enter_state": "safe_stop", "action": "command_virtual_stop"}
  ],
  "verification": {
    "scenarios": [
      "nominal_navigation",
      "speed_command_over_limit",
      "stale_proximity_150ms",
      "planner_process_crash",
      "delayed_command",
      "dropped_message",
      "corrupted_message",
      "simulator_disconnect"
    ],
    "requirements": [
      {"id": "REQ-AMR-01", "claim": "Over-limit speed commands are rejected by the guard.",
       "scenario": "speed_command_over_limit"},
      {"id": "REQ-AMR-02", "claim": "Stale proximity latches a virtual stop until reset.",
       "scenario": "stale_proximity_150ms"}
    ]
  },
  "simulation": {"dt_ms": 10, "duration_ms": 10000, "seed": 0}
}
