{
  "schema_version": 1,
  "machine": {
    "id": "cell-demo-01",
    "kind": "industrial_cell",
    "execution_target": "qnx8_x86_64_qemu",
    "simulation_only": true
  },
  "actuators": [
    {"id": "amr-drive", "type": "velocity_command"},
    {"id": "belt-drive", "type": "belt_speed_command"}
  ],
  "sensors": [
    {"id": "amr-odometry", "type": "odometry", "freshness_limit_ms": 100},
    {"id": "belt-speed", "type": "belt_speed_mps", "freshness_limit_ms": 100},
    {"id": "station-presence", "type": "presence_bool", "freshness_limit_ms": 100},
    {"id": "cell-estop", "type": "estop_bool", "freshness_limit_ms": 50}
  ],
  "control": {
    "period_ms": 10,
    "max_linear_speed_mps": 0.3,
    "max_angular_speed_radps": 1.0,
    "guarded_state_transitions": true
  },
  "safety_contracts": [
    {"name": "stale-presence-inhibit", "if": "proximity_is_stale", "then": "command_virtual_stop"},
    {"name": "speed-limit", "if": "speed_exceeds_limit", "then": "reject_command"},
    {"name": "simulator-watchdog", "if": "simulator_disconnected", "then": "command_virtual_stop"}
  ],
  "verification": {
    "scenarios": [
      "cell_nominal_transfer",
      "cell_transfer_jam",
      "cell_estop_during_transfer",
      "cell_stale_presence"
    ]
  },
  "cell": {
    "station_x_m": 6.0,
    "transfer_ticks": 50,
    "presence_sensor": "station-presence",
    "amr_actuator": "amr-drive",
    "belt_actuator": "belt-drive"
  }
}
