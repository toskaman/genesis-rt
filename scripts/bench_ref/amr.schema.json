{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hand-maintained AMR IR v1 validation schema (benchmark reference ONLY)",
  "description": "Checked-in stand-in for what a diligent team hand-writes without GENESIS RT. Covers the v1 control block, sensor freshness shape, and top-level strictness. Deliberately NOT covered: cross-field semantics (limit vs nominal), transition tables, actuators detail, v2 constructs. Must be extended by hand for every new IR rule, machine kind, and schema version.",
  "type": "object",
  "required": ["schema_version", "control", "sensors", "verification"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer"},
    "machine": {"type": "object"},
    "control": {
      "type": "object",
      "required": ["period_ms", "max_linear_speed_mps", "max_angular_speed_radps"],
      "properties": {
        "period_ms": {"type": "number", "exclusiveMinimum": 0},
        "max_linear_speed_mps": {"type": "number", "exclusiveMinimum": 0},
        "max_angular_speed_radps": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "sensors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "freshness_limit_ms"],
        "properties": {
          "id": {"type": "string"},
          "freshness_limit_ms": {"type": "integer", "minimum": 1, "maximum": 60000}
        }
      }
    },
    "actuators": {"type": "array"},
    "safety_contracts": {"type": "array"},
    "verification": {
      "type": "object",
      "required": ["scenarios"],
      "properties": {
        "scenarios": {"type": "array", "minItems": 1}
      }
    }
  }
}
